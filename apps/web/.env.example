# Local deploy only. Do not commit real tokens or R2 keys.
# Token needs Account → Workers Scripts → Edit, plus Zone → DNS → Edit for fhjh.me.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
# Optional: wrangler secret EXAM_PUBLISH_KEY (admin /api/exam writes)
# R2 S3 endpoint/keys stay out of git. Enable R2 in the dashboard before binding a bucket.
