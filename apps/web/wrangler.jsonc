{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fhjh-me",
  "compatibility_date": "2026-09-13",
  "preview_urls": true,
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "routes": [
    { "pattern": "fhjh.me", "custom_domain": true },
    { "pattern": "www.fhjh.me", "custom_domain": true }
  ]
}
